# ── TinyFish ─────────────────────────────────────────────────────────────────
# Get a key at https://agent.tinyfish.ai/  (Search & Fetch are free).
# NOTE: use a NEW, rotated key — never commit your real .env.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Endpoint bases (defaults shown — override only if TinyFish tells you to).
TINYFISH_AGENT_URL=https://agent.tinyfish.ai
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# Managed Browser (Playwright connect-over-CDP). Optional — only needed for
# the browser-driven extraction targets. Ask TinyFish for your CDP endpoint.
TINYFISH_BROWSER_CDP_URL=

# ── App ──────────────────────────────────────────────────────────────────────
# Which config profile to load from ./config (default: lab).
EXTRACTOR_PROFILE=lab

# Node server port.
PORT=3000

# Optional LLM for post-processing/summarisation (leave blank to skip).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
